ASSISTANT_HAS_OWN_NUMBER=

# Google Calendar MCP server — run /tmp/get-gcal-token.mjs once to populate these
GCAL_CLIENT_ID=         # GCP → APIs & Services → Credentials → OAuth 2.0 Client ID
GCAL_CLIENT_SECRET=     # Same GCP OAuth client
GCAL_REFRESH_TOKEN=     # Output by get-gcal-token.mjs after browser auth
GCAL_MCP_PORT=3020      # Port the MCP server listens on

# Speech-to-text (voice note transcription via local whisper.cpp server)
# See setup/whisper.service to install the systemd service
WHISPER_SERVER_URL=http://127.0.0.1:8080

# Journal draft endpoint — one-shot HTTP endpoint for randoread's floating
# "Send to oh-two" journal input (src/journal-draft.ts). See main.md §05.05.02
# "Security" before setting JOURNAL_DRAFT_BIND_HOST to anything but loopback —
# randoread runs on a different host, so this must go over a private network
# (Tailscale), never a public or plain-LAN interface.
JOURNAL_DRAFT_PORT=3021
JOURNAL_DRAFT_BIND_HOST=127.0.0.1       # set to this host's Tailscale IP (100.x.x.x) to allow randoread's host to reach it
JOURNAL_DRAFT_API_KEY=                  # shared secret; generate with `openssl rand -hex 32`. Unset = endpoint refuses all requests.
JOURNAL_DRAFT_MAX_CONCURRENT=2
